# ---------------------------------------------------------------------------
# Self-hosted Supabase – Konfiguration
# Kopieren nach /opt/supabase/.env und ALLE Platzhalter ersetzen.
# Diese Datei niemals mit echten Werten committen.
# ---------------------------------------------------------------------------

## Öffentliche Hostnamen (DNS A-Record -> VPS-IP)
API_HOST=db.fahrschule-me.ch
STUDIO_HOST=studio.fahrschule-me.ch
SUPABASE_PUBLIC_URL=https://db.fahrschule-me.ch
SITE_URL=https://www.fahrschule-me.ch
ADDITIONAL_REDIRECT_URLS=https://www.fahrschule-me.ch,https://fahrschule-me.ch,http://localhost:8080

## Datenbank
POSTGRES_DB=postgres
POSTGRES_PASSWORD=CHANGE_ME_STARKES_PASSWORT

## JWT – Secret erzeugen:  openssl rand -base64 48
## ANON_KEY / SERVICE_ROLE_KEY passend dazu erzeugen:
##   docker run --rm -e JWT_SECRET=... supabase/gotrue ...  ODER
##   scripts/generate-keys.mjs (im selben Ordner)
JWT_SECRET=CHANGE_ME_MIN_32_ZEICHEN
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_JWT_ANON
SERVICE_ROLE_KEY=CHANGE_ME_JWT_SERVICE_ROLE
SECRET_KEY_BASE=CHANGE_ME_64_ZEICHEN

## PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public

## Auth
DISABLE_SIGNUP=true
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

## SMTP für Auth-Mails (Resend SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=info@drive-me.ch
SMTP_SENDER_NAME=Fahrschule ME

## Studio
STUDIO_DEFAULT_ORGANIZATION=Fahrschule ME
STUDIO_DEFAULT_PROJECT=Produktion
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME
# htpasswd -nbB admin 'passwort'   → Ergebnis hier eintragen ($ verdoppeln: $$)
STUDIO_BASIC_AUTH=admin:$$2y$$05$$CHANGE_ME

## App-Secrets für Edge Functions
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GEMINI_API_KEY=
LOVABLE_API_KEY=

## Backups
BACKUP_DIR=/opt/supabase/backups
BACKUP_RETENTION_DAYS=30
