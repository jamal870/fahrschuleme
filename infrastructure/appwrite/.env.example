# Appwrite Production Environment
# Kopiere diese Datei nach .env und fülle alle Werte aus.

# Domains
_APP_DOMAIN=api.fahrschule-me.ch
_APP_DOMAIN_TARGET=api.fahrschule-me.ch
_APP_DOMAIN_FUNCTIONS=functions.api.fahrschule-me.ch

# Security
# Generiere mit: openssl rand -base64 32
_APP_OPENSSL_KEY_V1=CHANGE_ME
_APP_EXECUTOR_SECRET=CHANGE_ME

# Console Access
_APP_CONSOLE_WHITELIST_ROOT=enabled
_APP_CONSOLE_WHITELIST_EMAILS=admin@fahrschule-me.ch
_APP_CONSOLE_WHITELIST_IPS=

# System Email (wird von Appwrite selbst verwendet, z. B. Passwort-Reset)
_APP_SYSTEM_EMAIL_NAME=Fahrschule Me
_APP_SYSTEM_EMAIL_ADDRESS=noreply@fahrschule-me.ch
_APP_SYSTEM_RESPONSE_EMAIL=info@fahrschule-me.ch
_APP_SYSTEM_SECURITY_EMAIL_ADDRESS=info@fahrschule-me.ch

# HTTPS / Abuse
_APP_OPTIONS_ABUSE=enabled
_APP_OPTIONS_FORCE_HTTPS=enabled

# Database
_APP_DB_USER=appwrite
_APP_DB_PASS=CHANGE_ME_DB_USER
_APP_DB_ROOT_PASS=CHANGE_ME_DB_ROOT

# Redis
_APP_REDIS_USER=
_APP_REDIS_PASS=CHANGE_ME_REDIS

# SMTP (z. B. über Resend SMTP-Relay oder Hostinger)
_APP_SMTP_HOST=smtp.resend.com
_APP_SMTP_PORT=465
_APP_SMTP_SECURE=enabled
_APP_SMTP_USERNAME=resend
_APP_SMTP_PASSWORD=CHANGE_ME_RESEND_SMTP_KEY

# Storage
_APP_STORAGE_LIMIT=10000000
_APP_STORAGE_PREVIEW_EXPIRY=120
_APP_STORAGE_ANTIVIRUS=disabled
_APP_STORAGE_ANTIVIRUS_HOST=clamav
_APP_STORAGE_ANTIVIRUS_PORT=3310

# Functions
_APP_FUNCTIONS_SIZE_LIMIT=30000000
_APP_FUNCTIONS_TIMEOUT=900
_APP_FUNCTIONS_BUILD_TIMEOUT=900
_APP_FUNCTIONS_CPUS=1
_APP_FUNCTIONS_MEMORY=512
_APP_FUNCTIONS_RUNTIMES=node-18

# Logging
_APP_LOGGING_PROVIDER=
_APP_LOGGING_CONFIG=

# Maintenance
_APP_MAINTENANCE_INTERVAL=86400
_APP_MAINTENANCE_RETENTION_AUDIT=1209600
_APP_MAINTENANCE_RETENTION_ABUSE=86400
_APP_MAINTENANCE_RETENTION_EXECUTION=1209600
_APP_MAINTENANCE_RETENTION_SCHEDULES=86400
_APP_MAINTENANCE_RETENTION_CACHE=2592000
_APP_MAINTENANCE_RETENTION_DELIVERY=86400
_APP_MAINTENANCE_RETENTION_BUILD=1209600

# VCS / GitHub (optional)
_APP_VCS_GITHUB_APP_NAME=
_APP_VCS_GITHUB_PRIVATE_KEY=
_APP_VCS_GITHUB_APP_ID=
_APP_VCS_GITHUB_CLIENT_ID=
_APP_VCS_GITHUB_CLIENT_SECRET=
_APP_VCS_GITHUB_WEBHOOK_SECRET=

# Migrations / Assistant (optional)
_APP_MIGRATIONS_FIREBASE_CLIENT_ID=
_APP_MIGRATIONS_FIREBASE_CLIENT_SECRET=
_APP_ASSISTANT_OPENAI_API_KEY=

# Storage Adapters (optional, falls S3 statt lokalem Storage)
_APP_STORAGE_DEVICE=local
_APP_STORAGE_S3_ACCESS_KEY=
_APP_STORAGE_S3_SECRET=
_APP_STORAGE_S3_REGION=
_APP_STORAGE_S3_BUCKET=
_APP_STORAGE_DO_SPACES_ACCESS_KEY=
_APP_STORAGE_DO_SPACES_SECRET=
_APP_STORAGE_DO_SPACES_REGION=
_APP_STORAGE_DO_SPACES_BUCKET=
_APP_STORAGE_BACKBLAZE_ACCESS_KEY=
_APP_STORAGE_BACKBLAZE_SECRET=
_APP_STORAGE_BACKBLAZE_REGION=
_APP_STORAGE_BACKBLAZE_BUCKET=
_APP_STORAGE_LINODE_ACCESS_KEY=
_APP_STORAGE_LINODE_SECRET=
_APP_STORAGE_LINODE_REGION=
_APP_STORAGE_LINODE_BUCKET=
_APP_STORAGE_WASABI_ACCESS_KEY=
_APP_STORAGE_WASABI_SECRET=
_APP_STORAGE_WASABI_REGION=
_APP_STORAGE_WASABI_BUCKET=
